# Marks Lombok-generated members with @lombok.Generated, which JaCoCo excludes from coverage.
# Without this, generated constructors and the @Slf4j logger field count as uncovered code and the
# coverage number moves when you add an annotation rather than when you add a test.
lombok.addLombokGeneratedAnnotation = true

# This is the project root; stop Lombok looking further up (outside the repo) for config.
config.stopBubbling = true
